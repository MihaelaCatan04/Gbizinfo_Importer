<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java.importer.mapper.PrepMapper">
    <update id="clearDataTables">
        TRUNCATE TABLE
            company_entry
    </update>
    <select id="getEntryCount" resultType="int">
        SELECT COUNT(*)
        FROM import_checkpoint
        WHERE date_completed = #{transaction_date}
          AND zip_entry_name = #{name}
    </select>

    <insert id="setCheckpoint">
        INSERT INTO import_checkpoint (date_completed, zip_entry_name)
        VALUES (#{transaction_date}, #{name})
    </insert>
</mapper>